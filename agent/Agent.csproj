<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Build a console application.  The service entry point is defined
         in AgentService.cs.  To register the service, you can use
         sc.exe create or integrate with an MSI in a later phase. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference WindowsCompat shim for ServiceBase support on .NET 8. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
</Project>